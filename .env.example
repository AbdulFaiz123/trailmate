# --- Database ---------------------------------------------------------------
# SQLite file for local development (path is relative to prisma/schema.prisma).
# To switch to Postgres later: change the provider in prisma/schema.prisma and
# use a URL like postgresql://user:pass@localhost:5432/trailmate
DATABASE_URL="file:./dev.db"

# --- Login -------------------------------------------------------------------------
# Passphrase for the /login page. Every page and API needs it (except the cron
# sweep, which uses CRON_SECRET). Without it the app is open in development and
# refuses to serve anything in production.
APP_PASSWORD=""
# Key that signs the login cookie. Optional: without it the key is derived from
# APP_PASSWORD. Generate one with:  openssl rand -base64 32
# Changing either logs every device out.
APP_SECRET=""

# --- Web Push (step 4) ----------------------------------------------------------
# Generate a pair with:  npm run push:keys
# Leave empty to run without push: alerts still appear in the app (bell + pop-ups).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT="mailto:you@example.com"

# --- Background jobs ------------------------------------------------------------
# The reminder sweep runs every minute inside the server. Set to 1 to turn it off
# (e.g. if you trigger POST /api/cron/sweep from an external cron instead).
SCHEDULER_DISABLED=""
# If set, POST /api/cron/sweep requires the header  Authorization: Bearer <secret>
CRON_SECRET=""
# Show the "pretend time" developer tools in Settings outside development.
DEMO_TOOLS=""

# --- Live transport (step 5) ---------------------------------------------------
# Deutsche Bahn live data via the free public API (no key needed).
#   live = use it for TRAIN legs that have DB station ids (default)
#   mock = use mock data for every leg (offline demos)
#   off  = don't track trains at all
DB_REST_MODE="live"
# Point at a self-hosted db-rest instance if the public one is down.
DB_REST_URL="https://v6.db.transport.rest"

# --- Documents vault (step 6) -----------------------------------------------------
# Where uploaded tickets, bookings, visas... are stored (git-ignored).
STORAGE_DIR="storage"

# --- Smart import (step 7) ---------------------------------------------------------
# OpenAI reads photos, PDFs and voice messages. Without a key, only pasted text
# (simple built-in reader) and the demos work. Get a key at platform.openai.com.
OPENAI_API_KEY=""
# Model for reading documents/text (Structured Outputs + vision + PDF input).
#   gpt-6.1-sol  balanced (default) · gpt-6-astra  most capable · gpt-6-luna  cheapest/fastest
OPENAI_MODEL="gpt-6.1-sol"
# Speech-to-text model for voice messages.
OPENAI_TRANSCRIBE_MODEL="gpt-transcribe"
# Set to "mock" to force the simple reader even when a key is present.
IMPORT_MODE=""
