# --- Database ---------------------------------------------------------------
# SQLite file for local development (path is relative to prisma/schema.prisma).
# To switch to Postgres later: change the provider in prisma/schema.prisma and
# use a URL like postgresql://user:pass@localhost:5432/trailmate
DATABASE_URL="file:./dev.db"

# --- Web Push (step 4) ----------------------------------------------------------
# Generate a pair with:  npm run push:keys
# Leave empty to run without push: alerts still appear in the app (bell + pop-ups).
VAPID_PUBLIC_KEY=""
VAPID_PRIVATE_KEY=""
# Contact for push services, e.g. mailto:you@example.com
VAPID_SUBJECT="mailto:you@example.com"

# --- Background jobs ------------------------------------------------------------
# The reminder sweep runs every minute inside the server. Set to 1 to turn it off
# (e.g. if you trigger POST /api/cron/sweep from an external cron instead).
SCHEDULER_DISABLED=""
# If set, POST /api/cron/sweep requires the header  Authorization: Bearer <secret>
CRON_SECRET=""
# Show the "pretend time" developer tools in Settings outside development.
DEMO_TOOLS=""
